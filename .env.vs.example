# ---------------------------------------------------------------------------
# Optional overrides for scripts/vs-launch.mjs (Visual Studio F5 launcher).
# Copy this file to ".env.vs" and uncomment the flags you need.
#
# After the first successful F5 run (which downloads ~200 MB of mihomo + geo
# data into extra/sidecar and extra/files) you almost certainly want to
# enable SKIP_PREPARE=1 so subsequent F5 presses are instant.
# ---------------------------------------------------------------------------

# Skip `pnpm install` even if node_modules is missing.
# SKIP_INSTALL=1

# Skip `pnpm prepare` on every launch (recommended after the first run).
# SKIP_PREPARE=1

# Force `pnpm prepare` to run again (e.g. to refresh geo data).
# FORCE_PREPARE=1
